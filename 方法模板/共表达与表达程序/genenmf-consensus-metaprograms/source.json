  "inputs": [
    {
      "path": "Data/seurat_obj.rds",
      "object": "Seurat",
      "requirements": "含 RNA assay 标准化表达且 sample 列区分至少 2 个样本",
      "evidence": "源码 SplitObject(seu, split.by = 'orig.ident') -> multiNMF(k = 4:9)"
    }
  ],
  "packages": [
    {
      "name": "Seurat",
      "tested_version": "5.5.0",
      "source_version": null
    },
    {
      "name": "GeneNMF",
      "tested_version": null,
      "source_version": null
    },
