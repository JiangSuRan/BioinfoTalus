      "tested_version": "2.14.0",
      "source_version": null
    },
    {
      "name": "dplyr",
      "tested_version": "1.1.4",
      "source_version": null
    }
  ],
  "prerequisites": [
    "运行目录存在 Data/ 与 results/；目标环境已安装 GeneNMF 与 msigdbr（runGSEA 联网或缓存访问 MSigDB）。"
  ],
  "outputs": [
    {
      "path": "results/genenmf_metaprograms.rds",
      "content": "GeneNMF 跨样本一致元程序及指标权重对象"
    },
    {
      "path": "results/genenmf_gsea_hallmark.rds",
      "content": "各元程序在 Hallmark 通路集的富集注释列表"
    },
    {
      "path": "results/seurat_with_mp_ucell.rds",
      "content": "写入各 MetaProgram UCell 活性的 Seurat 对象"
    }
  ],
  "method_choices": [
    {
      "setting": "multiNMF(k = 4:9) + getMetaPrograms(metric = 'cosine', nMP = 6, min.confidence = 0.7)",
      "basis": "源码跨多种因子数分解再经样本间余弦相似与置信度过滤，可避免单个样本批次噪声主导局部表达程序"
    },
    {
      "setting": "AddModuleScore_UCell(..., name = '')",
      "basis": "基于单细胞内基因表达排序的无参打分使跨样本元程序活性可比"
    }
  ],
  "adaptation": [
    "移除源码重复调用的两次 getMetaPrograms，直接一步施加 min.confidence = 0.7 稳健筛选并保留 Hallmark GSEA 注释与 UCell 回写。"
  ],
  "limitations": [
    "runGSEA 依赖 msigdbr 注释集合，离线集群需先缓存对应物种 MSigDB 数据。",
    "每个拆分子样本需保有足够高变基因与细胞量，否则部分秩 k 分解易不收敛。"
  ],
